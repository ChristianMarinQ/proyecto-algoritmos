 authors = {['Kübra Karakaya Özyer', 'Betül Aydin']},
 journal = {International Journal of Education in Mathematics, Science and Technology},
 keywords = {['Artificial Intelligence; Preservice Teachers; Student Attitudes; Computer Uses in Education; Adoption (Ideas); Performance Based Assessment']},
 title = {Generative Artificial Intelligence (GenAI) Meets Assessment: Experimental Insights into Teacher Candidates' Attitudes and Acceptance},
 year = {2026}
}

