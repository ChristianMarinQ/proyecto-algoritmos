@article{19176413020260301,
 abstract  = "Artificial intelligence is reshaping market research from a set of analytical tools into an active participant in the research process. As AI begins to generate questions, analyse data, and produce insights, it challenges the field's reliance on human judgement, methodological rigour, and interpretive expertise. This research note introduces the special issue on "AI in Market Research" and argues for a socio-technical perspective in which AI augments rather than replaces researchers. It highlights the epistemic, methodological, and ethical questions that will shape the future of market research.",
 author    = "Sung, Billy and Pitardi, Valentina and Paas, Leo and Cartwright, Trixie",
 number    = "2",
 title     = "Market Research in the Age of Generative AI: Opportunities and Challenges.",
 volume    = "68",
 url       = "https://research.ebsco.com/linkprocessor/plink?id=50ce660e-c478-34e5-aec3-d23efeba0473",
 year      = "2026",
 issn      = "1470-7853",
 journal   = "International Journal of Market Research",
 keywords  = "Generative artificial intelligence; Artificial intelligence; Data analysis; Marketing research; Sociotechnical systems; Marketing Research and Public Opinion Polling; Research methodology; Artificial intelligence & ethics; Theory of knowledge",
 pages     = "153-161",
 note      = "",
}